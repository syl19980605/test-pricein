# ===== LLM 配置 =====
# Bobby Agent 用的 API key。可以是 Anthropic 官方 key，
# 也可以是任意 Anthropic 兼容端点（如 MiMo）的 key。
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic 兼容端点地址。
# - 留空 = 用 Anthropic 官方 (https://api.anthropic.com)
# - 接 MiMo 等兼容模型时填入对应 base_url
ANTHROPIC_BASE_URL=

# Bobby Agent 使用的模型名。
# - Anthropic 官方: claude-sonnet-4-6
# - MiMo 等兼容模型: 填对应的模型标识
BOBBY_MODEL=claude-sonnet-4-6

# ===== 可选 =====
# 增强新闻分析（不填则只用 Yahoo Finance 新闻）
NEWSAPI_KEY=

# ===== 服务 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 数据库 =====
DB_PATH=./data/bobby.db

# ===== 后台监控间隔（秒）=====
MONITOR_INTERVAL_SECONDS=300
